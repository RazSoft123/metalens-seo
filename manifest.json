{
  "name": "Metalens SEO tool",
  "description": "Simple yet powerful tool to see metadata of your webisite",
  "version": "1.0.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": "icons/metalens-logo-32.png"
  },
  "background": {
    "service_worker": "src/services/background-service.js"
  },
  "content_scripts": [
    {
      "matches": "<all_urls>",
      "js": "src/content.js"
    }
  ],
  "permission": ["activeTab", "scripting"],
  "icons": {
    "16": "icons/metalens-logo-16.png",
    "32": "icons/metalens-logo-32.png",
    "48": "icons/metalens-logo-48.png",
    "128": "icons/metalens-logo-128.png"
  }
}
